# ========================================================
# Quantum Knowledge Weaver (QKW) - Configuration Settings
# ========================================================

# App Settings
DEBUG=true
HOST=0.0.0.0
PORT=8000

# LLM Providers (Multi-Provider Support: auto, gemini, groq, openai, ollama)
LLM_PROVIDER=auto

# 1. Google Gemini (Recommended for deep human-like synthesis & multimodal grounding)
# Get free API key: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Groq (Ultra-fast inference: < 400ms)
# Get free API key: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4. Ollama (Local & Free offline synthesis)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_FALLBACK_MODEL=qwen2.5
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30.0

# Quantum Optimization Engine
QUANTUM_BACKEND=simulator
QAOA_P_STEPS=1
MAX_APIS_TO_SELECT=3
# Optional: IBM Quantum Hardware Token (For real QPUs on IBM Quantum)
# IBM_QUANTUM_TOKEN=your_ibm_quantum_api_token_here

# Vector Memory (Qdrant)
# Leave empty to use embedded in-memory mode (:memory:), or set remote URL
# QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=qkw_queries

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# External API Configuration
API_TIMEOUT_SECONDS=10.0
API_MAX_RETRIES=2
